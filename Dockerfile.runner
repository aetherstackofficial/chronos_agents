# The runner service: the ONLY container that holds the Docker socket. It starts
# sealed strategy containers on behalf of the bridge (see runner/service.py).
# Docker CLI comes from the official CLI image; nothing else of Docker is installed.
FROM python:3.11-slim
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pyzmq
WORKDIR /app
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
COPY swarm_orchestrator/runner/ ./runner/
EXPOSE 8100
CMD ["uvicorn", "runner.service:app", "--host", "0.0.0.0", "--port", "8100"]
