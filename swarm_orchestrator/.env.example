# Chronos environment configuration — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# --- Networking (two-plane architecture) ---
ZMQ_HOST=127.0.0.1
ZMQ_ORDER_PORT=5555          # Order-entry plane: engine ROUTER <- agent/strategy DEALER sockets
ZMQ_DATA_PORT=5556           # Market-data plane: engine PUB -> all SUB subscribers (push)
ORACLE_PORT=5557             # Oracle service: bridge -> oracle news requests

# --- Web bridge ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000

# --- Persistence ---
CHRONOS_DB=chronos.db        # SQLite database file written by the engine, read by the bridge

# --- LLM Macro Oracle ---
GEMINI_API_KEY=your_gemini_api_key_here
