# Chronos environment configuration — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# --- Networking (two-plane architecture) ---
ZMQ_HOST=127.0.0.1
ZMQ_ORDER_PORT=5555          # Order-entry plane: engine ROUTER <- agent/strategy DEALER sockets
ZMQ_DATA_PORT=5556           # Market-data plane: engine PUB -> all SUB subscribers (push)
ORACLE_PORT=5557             # Oracle service: bridge -> oracle news requests

# --- Web bridge ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000

# --- Persistence ---
CHRONOS_DB=chronos.db        # SQLite database file written by the engine, read by the bridge

# --- LLM Macro Oracle (three scoring tiers, tried in order) ---
# Tier 1. Best quality; free tier is only 20 requests/day/model.
GEMINI_API_KEY=your_gemini_api_key_here
# Tier 2. Used when Gemini fails or its quota is spent. Free key from
# console.groq.com. Without it an exhausted Gemini quota drops scoring to the
# keyword lexicon, which returns 0.00 for any wording it does not know.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override if Groq retires the default model (llama-3.3-70b-versatile).
#GROQ_MODEL=llama-3.3-70b-versatile
# Tier 3 is the built-in deterministic lexicon -- no key, always available.
